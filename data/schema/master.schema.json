{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutawaysecurity.com/threat_hunt_china_entities/master.schema.json",
  "title": "threat_hunt_china_entities master dataset",
  "description": "Single nested source of truth: entity -> software -> indicator -> typed claims. An indicator cannot exist without its software, company, and the claims/citations that justify it. No file hashes or version-pinned values are permitted as indicator values (DR-09/DR-10); a verification hash lives only in a claim's raw provenance, never as an indicator. Cross-field tier rules (e.g. VERIFIED needs >=2 classes incl. one vendor-official for the specific indicator type) are enforced by gates.py, not expressible in JSON Schema alone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "entities", "delisted", "backlog"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_pdf", "source_date", "list_version", "best_effort"],
      "properties": {
        "source_pdf": {"type": "string"},
        "source_url": {"type": "string"},
        "source_date": {"type": "string", "description": "Date of the 1260H list (e.g. 2026-06-08)"},
        "list_version": {"type": "string"},
        "generated": {"type": "string"},
        "best_effort": {"const": true, "description": "AI-assisted, best-effort; must always be true and surfaced on exports."}
      }
    },
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "delisted": {
      "type": "array",
      "description": "Previously listed, removed; retained for reference, out of scope.",
      "items": {"type": "string"}
    },
    "backlog": {
      "type": "array",
      "description": "REPORTED/CANDIDATE indicators (incl. anything traceable to the quarantine). Separate namespace; never exported.",
      "items": {"$ref": "#/$defs/indicator"}
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company_id", "name", "disposition", "disposition_justification", "software"],
      "properties": {
        "company_id": {"type": "string", "pattern": "^C[0-9]{4}$"},
        "name": {"type": "string"},
        "short_alias": {"type": ["string", "null"]},
        "affiliation_rationale": {"type": "string", "description": "Verbatim 1260H affiliation text."},
        "subsidiaries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {"name": {"type": "string"}, "short_alias": {"type": ["string", "null"]}}
          }
        },
        "disposition": {
          "enum": [
            "indicators_identified",
            "software_no_verified_indicators",
            "server_or_linux_only",
            "hardware_or_firmware_only",
            "no_windows_software_found",
            "candidate_pending_verification"
          ]
        },
        "disposition_justification": {"type": "string", "minLength": 1},
        "software": {"type": "array", "items": {"$ref": "#/$defs/software"}}
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": ["software_id", "name", "vendor_company_id", "catalog_status", "indicators"],
      "properties": {
        "software_id": {"type": "string", "pattern": "^S[0-9]{4}$"},
        "name": {"type": "string"},
        "vendor_company_id": {"type": "string", "pattern": "^C[0-9]{4}$"},
        "category": {"type": "string"},
        "windows_installable": {"type": "boolean"},
        "catalog_status": {
          "enum": ["verified", "reported", "candidate"],
          "description": "Layer-2 provenance of the software fact: verified=vendor-official source confirms the vendor publishes this Windows software; reported=reputable third-party (winget/NVD/catalog); candidate=lead only, unconfirmed."
        },
        "source_url": {"type": "string", "description": "Where the software fact was confirmed."},
        "attribution_note": {"type": "string"},
        "cpe": {
          "type": "string",
          "description": "CPE 2.3 with the version field WILDCARDED (no version pin).",
          "pattern": "^cpe:2\\.3:[aho]:[^:]+:[^:]+:\\*:"
        },
        "indicators": {"type": "array", "items": {"$ref": "#/$defs/indicator"}}
      }
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "description": "A host-based artifact. NO 'hash' and NO 'version' property are permitted (additionalProperties:false enforces it). 'value' MUST be the stable, version-independent form.",
      "required": ["indicator_id", "indicator_type", "value", "presence_class", "confidence_tier", "claims"],
      "properties": {
        "indicator_id": {"type": "string", "pattern": "^I[0-9]{4}$"},
        "indicator_type": {
          "enum": ["FILE_NAME", "FILE_PATH", "FOLDER_PATH", "REGISTRY_KEY", "SERVICE_NAME", "DLL_NAME", "PROCESS_NAME"]
        },
        "value": {"type": "string", "minLength": 1},
        "presence_class": {"enum": ["product_installed", "sdk_embedded"]},
        "confidence_tier": {"enum": ["VERIFIED", "CORROBORATED", "REPORTED", "CANDIDATE"]},
        "date_verified": {"type": "string", "description": "ISO date of the most recent successful source fetch."},
        "notes": {"type": "string"},
        "claims": {
          "type": "array",
          "minItems": 1,
          "description": "Atomic typed evidence. Each claim is credited only for what it proves (DR-02a).",
          "items": {"$ref": "#/$defs/claim"}
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_type", "source_class", "source_url", "proves", "date_verified"],
      "properties": {
        "claim_type": {
          "enum": ["binary_signer", "installer_filename", "arp_publisher", "product_naming", "sdk_dll_name", "service_name", "install_path", "registry_key", "process_name"]
        },
        "source_class": {
          "enum": ["vendor_official", "winget", "nvd_cpe", "virustotal", "vendor_sdk_pdf", "reputable_third_party"]
        },
        "source_url": {"type": "string", "minLength": 1},
        "proves": {"type": "string", "description": "Exactly what this source establishes (e.g. 'binary X is code-signed by vendor Y')."},
        "date_verified": {"type": "string"},
        "raw_value": {"type": "string", "description": "The un-normalized source string (may be version-specific). Provenance only; never copied to indicator.value."}
      }
    }
  }
}
